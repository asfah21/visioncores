# Copy to .env (never commit .env — it holds camera secrets)
CAM1_RTSP_URL=rtsp://username:password@camera-host:8554/Streaming/Channels/101

# Shared JWT secret MUST match frontend JWT_SECRET and backend JWT_SECRET
JWT_SECRET=visioncore-super-secret-key-change-in-production

# Service-to-service token for YOLO -> POST /detection (empty = open legacy mode)
INTERNAL_API_TOKEN=

# Key for camera password encryption in Postgres (32+ chars, rotate carefully)
CREDENTIAL_KEY=visioncore-credential-key-change-me-32b

# Recording retention (days). Janitor purges files + rows older than this.
RECORDING_RETENTION_DAYS=7
